FROM node:24-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund && npm cache clean --force
COPY router.mjs advisor.mjs mcp-server.mjs mcp-usage.mjs mcp-auth.mjs ./
ENV NODE_ENV=production MCP_HOST=0.0.0.0 MCP_PORT=3002
USER node
EXPOSE 3002
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s CMD node -e "fetch('http://127.0.0.1:'+(process.env.MCP_PORT||3002)+'/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "mcp-server.mjs"]
