TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
PORT=3000
# Optional: one exact HTTPS tunnel origin. This enables public access without a password.
PUBLIC_ORIGIN=
# Microsoft-Decision-1: resource origin (not a project URL), deployment name, and server-side key.
FOUNDRY_ENDPOINT=
DECISION_DEPLOYMENT=
FOUNDRY_API_KEY=

# Optional MCP server (separate from the web demo). Generate independent random client keys.
MCP_API_KEYS=
MCP_HOST=127.0.0.1
MCP_PORT=3002
# Required when binding 0.0.0.0; terminate HTTPS at your gateway.
MCP_PUBLIC_ORIGIN=
MCP_REDIS_URL=redis://127.0.0.1:6379
MCP_REDIS_NAMESPACE=architecture-advisor
# Shared comparisons per fixed 60-second window across replicas.
MCP_RATE_LIMIT=60
# In-flight comparisons per replica. No request queue.
MCP_MAX_CONCURRENT=8
