TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
PORT=3000
# Optional: one exact HTTPS tunnel origin. This enables public access without a password.
PUBLIC_ORIGIN=
# Microsoft-Decision-1: resource origin (not a project URL), deployment name, and server-side key.
FOUNDRY_ENDPOINT=
DECISION_DEPLOYMENT=
FOUNDRY_API_KEY=

# Optional MCP server (separate from the web demo). Single-tenant Entra v2 access tokens.
MCP_ENTRA_TENANT_ID=
# Application (client) ID of the MCP API registration, NOT the calling client application.
MCP_ENTRA_CLIENT_ID=
MCP_ENTRA_SCOPE=Advisor.Invoke
# Optional: enable app-only callers with this assigned app role AND the idtyp=app claim.
MCP_ENTRA_APP_ROLE=
MCP_HOST=127.0.0.1
MCP_PORT=3002
# Required when binding 0.0.0.0; terminate HTTPS at your gateway.
MCP_PUBLIC_ORIGIN=
MCP_TABLE_ENDPOINT=
MCP_TABLE_NAME=AdvisorUsage
MCP_TABLE_NAMESPACE=architecture-advisor
# Local dev: default (DefaultAzureCredential). Azure: managed-identity.
MCP_TABLE_CREDENTIAL=default
# Leave blank for system-assigned managed identity.
MCP_TABLE_MANAGED_IDENTITY_CLIENT_ID=
# Shared comparisons per fixed 60-second window across replicas.
MCP_RATE_LIMIT=60
# In-flight comparisons per replica. No request queue.
MCP_MAX_CONCURRENT=8
